{
  "name": "hal-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "A generic AI chat server framework with pluggable providers, tools, and transport",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch example/server.ts",
    "build": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint --max-warnings 0 .",
    "lint:backlog": "eslint -c eslint.config.backlog.mjs .",
    "check:spec-links": "node scripts/check-spec-links.mjs",
    "check:spec-status": "node scripts/check-spec-status.mjs",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "prettier:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.986.0",
    "@google-cloud/vertexai": "^1.10.4"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@google-cloud/vertexai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.986.0",
    "@eslint/js": "^9.9.0",
    "@eslint/markdown": "^8.0.3",
    "@google-cloud/vertexai": "^1.10.4",
    "@re-cinq/eslint-plugin-re-lint": "^1.3.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "jscpd": "^5.2.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "yaml": "^2.9.0"
  }
}
